# Copy to .env.local for local `next dev`, or set the same keys in Vercel → Settings → Environment Variables.
# Never prefix these with NEXT_PUBLIC_ — the GitHub token must stay server-only.

# HMAC secret for the httpOnly session cookie (blog_session). Use a long random string in production.
AUTH_SECRET=

# Authoring / login: local `next dev` only. Public Vercel deploy never enables it.
# NEXT_PUBLIC_AUTHORING=0   # force off
# Do NOT set NEXT_PUBLIC_AUTHORING=1 on production (joshlog.blog).
#
# Easiest local setup (uses `gh auth token` + your login):
#   npm run setup:image-env -- --repo blog-images --create
#   npm run setup:image-env -- --print   # dry-run

# Fine-grained PAT with Contents: Read and write on the image hosting repo
# (classic PAT: repo scope). Either name works:
GITHUB_IMAGE_UPLOAD_TOKEN=
# GITHUB_TOKEN=

# Target repo for Method A (virtual commit via Contents API)
GITHUB_IMAGE_OWNER=your-github-username
GITHUB_IMAGE_REPO=your-image-hosting-repo

# Optional (defaults shown)
# GITHUB_IMAGE_BRANCH=main
# GITHUB_IMAGE_PATH_PREFIX=images

# Public URL returned by POST /api/upload-image (private-repo safe):
#   /api/images/{path}  → server proxies raw GitHub content with the token
# The image hosting repo can stay private.

# ── Comments ─────────────────────────────────────────────────
# Local `next dev`: no env needed → data/comments.local.json
# Production / shared: Supabase project (active) + schema.sql
# See docs/comments-supabase.md
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# COMMENTS_LOCAL=1   # force local file store
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Obsidian import (/api/obsidian/notes, /articles/new picker)
# Enabled automatically in `next dev`. For local `next start`, set:
# NEXT_PUBLIC_LOCAL_TOOLS=1
# OBSIDIAN_VAULT=~/okestro
